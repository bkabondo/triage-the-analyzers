<?xml version="1.0" encoding="UTF-8"?>
<!-- PMD rules for Project Pulse: PMD's quickstart set, minus the rules the team has decided not to
     enforce. To drop a rule, add an exclude inside the quickstart reference, with a comment giving
     the reason, for example:

       <exclude name="ControlStatementBraces"/>

     To add a rule from outside quickstart, add its own <rule ref="category/java/..."/> line.
     Every change here is a reviewed decision. -->
<ruleset name="Project Pulse"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD quickstart, with Project Pulse's decisions.</description>
    <rule ref="rulesets/java/quickstart.xml">
        <!-- D4, 2026-11-13: off project-wide. Every log call in this codebase uses SLF4J's
             parameterized form ("{}" placeholders), so the message is never concatenated unless the
             level is enabled, and the arguments we pass are field reads, getters, and collection
             sizes - trivial to evaluate. An isDebugEnabled() guard around each one would add a
             branch per call site and buy nothing.
             Checkable: no log call in src/main/java builds its message with "+" or String.format;
             if one appears, the guard question is back and so is this rule. -->
        <exclude name="GuardLogStatement"/>

        <!-- D2, 2026-11-13: narrowed, not dropped. JPA requires a no-arg constructor on every
             entity, and such a constructor is necessarily empty and necessarily redundant-looking,
             so both rules fire on code the framework forces us to write. The re-declarations below
             keep both rules on everywhere else (a hand-written empty or redundant constructor in a
             service, DTO, or plain value object still fails the build) and suppress them only for a
             zero-argument constructor inside a @Entity / @MappedSuperclass / @Embeddable class. -->
        <exclude name="UncommentedEmptyConstructor"/>
        <exclude name="UnnecessaryConstructor"/>
    </rule>

    <!-- D2 re-declarations. The XPath is evaluated against the reported ConstructorDeclaration: it
         suppresses only when the constructor takes no parameters AND its enclosing class is mapped
         by JPA. Checkable: break either half (give the constructor a parameter, or drop the
         @Entity) and the violation comes back. -->
    <rule ref="category/java/documentation.xml/UncommentedEmptyConstructor">
        <properties>
            <property name="violationSuppressXPath"
                      value="self::ConstructorDeclaration[
                                 FormalParameters[@Size = 0]
                                 and ancestor::ClassDeclaration[1]/ModifierList/Annotation[
                                     pmd-java:typeIs('jakarta.persistence.Entity')
                                     or pmd-java:typeIs('jakarta.persistence.MappedSuperclass')
                                     or pmd-java:typeIs('jakarta.persistence.Embeddable')]]"/>
        </properties>
    </rule>
    <rule ref="category/java/codestyle.xml/UnnecessaryConstructor">
        <properties>
            <property name="violationSuppressXPath"
                      value="self::ConstructorDeclaration[
                                 FormalParameters[@Size = 0]
                                 and ancestor::ClassDeclaration[1]/ModifierList/Annotation[
                                     pmd-java:typeIs('jakarta.persistence.Entity')
                                     or pmd-java:typeIs('jakarta.persistence.MappedSuperclass')
                                     or pmd-java:typeIs('jakarta.persistence.Embeddable')]]"/>
        </properties>
    </rule>
</ruleset>
